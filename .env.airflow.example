# Copy to .env.airflow outside Git and fill every empty value. Used with the
# Gold variables already in .env (see docs/ORQUESTACION_AIRFLOW.md):
#   docker compose -f compose.gold.yaml -f compose.airflow.yaml \
#     --env-file .env --env-file .env.airflow up -d --build

# Secrets. Generate once per environment and never reuse across environments:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"           DB password / JWT secret / admin password
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   Fernet key
AIRFLOW_DB_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# Independent destination for daily backups; must already be mounted.
HOST_GOLD_BACKUP_ROOT=

# Owner of the Gold store (docs/OPERACION_GOLD.md assigns UID 10001).
AIRFLOW_UID=10001
# Plant wall-clock zone: cutoffs are local industrial time.
GOLD_PLANT_TIMEZONE=Europe/Madrid
# Rollback window: nightly VACUUM keeps every publication younger than this.
GOLD_PUBLICATION_RETENTION_DAYS=30
# Airflow UI, bound to 127.0.0.1 behind the corporate proxy.
AIRFLOW_PORT=8085
