# Ejemplo local; copiar a un archivo externo al repositorio y adaptar la ruta.
APP_DATA_BACKEND=gold
APP_DATA_ROOT=C:/calidad-serie-data/gold-application-v3-release
APP_GOLD_ROOT=C:/calidad-serie-data/gold-application-v3-release
APP_HOST=127.0.0.1
APP_PORT=8003
APP_SCORE_QUERY_MAX_CONCURRENCY=1
APP_GOLD_QUERY_MAX_ROWS=250000
APP_GOLD_QUERY_TOTAL_ROWS=500000
# Solo demostracion local. Exposicion corporativa: trusted_proxy y proxy HTTPS.
APP_AUTH_MODE=disabled
