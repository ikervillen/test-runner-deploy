{
  "repository": "ikervillen/test-runner-deploy",
  "namespace": "fenix-aiala",
  "docker_context": "default",
  "state_root": "C:/ProgramData/FenixIngesta/deployments",
  "input_bind": "C:/DataSharing/Fenix",
  "frontend_bind_address": "127.0.0.1",
  "frontend_remote_subnet": null,
  "drain_seconds": 1800,
  "interval_seconds": 600,
  "environments": {
    "develop": {
      "volume": "fenix-aiala-develop",
      "instance": "11111111111111111111111111111111",
      "review_volumes": {
        "commands": "fenix-aiala-develop-review-commands",
        "results": "fenix-aiala-develop-review-results"
      }
    },
    "main": {
      "volume": "fenix-aiala-main",
      "instance": "22222222222222222222222222222222",
      "review_volumes": {
        "commands": "fenix-aiala-main-review-commands",
        "results": "fenix-aiala-main-review-results"
      }
    }
  },
  "settings": {
    "plant": "AIALA",
    "sources": {
      "AV21": "AV21",
      "AV22": "AV22",
      "AV23": "AV23",
      "AV31": "AV31",
      "AV32": "AV32"
    },
    "encoding": "cp1252",
    "line_by_origin": {
      "AV21": "AV21",
      "AV22": "AV22",
      "AV23": "AV23",
      "AV31": "AV31",
      "AV32": "AV32"
    },
    "line_code_by_origin": {
      "AV21": 21,
      "AV22": 22,
      "AV23": 23,
      "AV31": 31,
      "AV32": 32
    }
  }
}
