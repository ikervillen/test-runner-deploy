# Copy this file to .env and replace each placeholder with the paths on the
# target server. Data is intentionally outside the Git checkout.
HOST_DATA_ROOT=C:\calidad-serie-data
APP_DATA_ROOT=C:\calidad-serie-data\AV-2024-2026_parquet
APP_ALERTS_REJECTIONS_ROOT=C:\calidad-serie-data\avisos_rechazos_parquet
APP_INSPECTED_TOTALS_ROOT=C:\calidad-serie-data\inspeccionadas_totales_parquet
# La ruta interna se configura en Compose como /data/quality_aggregates.
# Mantener la release publicada bajo HOST_DATA_ROOT\quality_aggregates.
APP_HOT_END_YIELD_PATH=C:\calidad-serie-data\Rendimiento_ZC.xlsx
APP_DEFECT_SEVERITY_PATH=C:\calidad-serie-data\Tabla defectos con criticidades.xlsx
APP_ALERT_DEFECT_NORMALIZATION_PATH=C:\calidad-serie-data\Programacion defectos MDL_enviado V01.xlsx
APP_DEFECT_CATALOG_PATH=C:\calidad-serie-data\COD_DEF.xlsx
APP_FOUR_HOUR_OFFSET_HOURS=0
APP_SCORE_CACHE_SIZE=3
APP_SCORE_QUERY_MAX_CONCURRENCY=2
APP_SCORE_QUERY_QUEUE_TIMEOUT_SECONDS=1
APP_SCORE_QUERY_TIMEOUT_SECONDS=180
# Un worker por defecto: cache y semaforo de consultas son por worker, asi que
# cada worker extra multiplica memoria. Las metricas se agregan entre workers
# automaticamente (PROMETHEUS_MULTIPROC_DIR, ver backend/entrypoint.sh).
APP_WEB_CONCURRENCY=1
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5
# En produccion, el proxy corporativo debe eliminar cabeceras entrantes no
# fiables y establecer estas cabeceras tras validar la identidad.
APP_AUTH_MODE=trusted_proxy
APP_AUTH_TRUSTED_USER_HEADER=X-Forwarded-User
APP_AUTH_TRUSTED_ROLES_HEADER=X-Forwarded-Roles
APP_AUTH_VIEWER_ROLE=quality_viewer
APP_AUTH_MANAGER_ROLE=quality_manager
APP_AUTH_METRICS_ROLE=quality_admin
