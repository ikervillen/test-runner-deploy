{
  "uid": "calidad-gold",
  "title": "Calidad de serie · Gold",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "timezone": "Europe/Madrid",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "quality",
    "gold"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Último éxito del publicador",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fenix-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - calidad_gold_last_success_timestamp_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Ventanas pendientes",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fenix-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "calidad_gold_pending_scopes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Duración p95 de publicación",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fenix-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, rate(calidad_gold_duration_seconds_bucket[30m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Latencia HTTP p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fenix-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(calidad_http_request_duration_milliseconds_bucket[15m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Ventanas MIA reutilizadas",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fenix-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "calidad_gold_mia_windows_reused_last"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Última copia verificada",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fenix-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - calidad_gold_backup_success_timestamp_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Frescura de Silver (latido de la ingesta)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fenix-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "Antigüedad de la publicación Silver",
          "expr": "time() - calidad_gold_source_publication_timestamp_seconds"
        },
        {
          "refId": "B",
          "legendFormat": "Retraso {{family}}",
          "expr": "calidad_gold_source_discovery_lag_seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Cobertura: producciones bloqueadas y retraso máximo del corte",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fenix-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "Retraso máximo del corte (s)",
          "expr": "calidad_gold_coverage_max_lag_seconds"
        },
        {
          "refId": "B",
          "legendFormat": "Producciones bloqueadas",
          "expr": "calidad_gold_coverage_blocked_productions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [{"id": "unit", "value": "none"}]
          }
        ]
      }
    }
  ]
}
